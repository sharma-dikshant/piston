# Copy to .env (next to docker-compose.yaml); docker compose loads it automatically.

# Shared secret for the API. Required: the API will not start without it.
# Clients send its SHA-256 hex digest in the x-api-key header.
# Generate one with: openssl rand -hex 32
PISTON_API_KEY=change-me

# Host interface the API port is published on. Keep 127.0.0.1 when your backend
# runs on the same host; use 0.0.0.0 (or a private IP) to reach it from elsewhere.
PISTON_HOST_BIND=127.0.0.1

# Roughly the number of vCPUs. Each job can use up to 256 MB.
PISTON_MAX_CONCURRENT_JOBS=4

# Container resource caps.
PISTON_MEM_LIMIT=3g
PISTON_CPUS=2

PISTON_LOG_LEVEL=INFO
